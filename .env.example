# Copy this file to .env and fill it in. Never commit .env anywhere.

# --- Required ---

# Your OpenAI API key (platform.openai.com -> API keys)
OPENAI_API_KEY=sk-...

# Secret token your phone must send with every upload.
# Generate one with:  openssl rand -hex 24
PLANNER_TOKEN=

# --- Optional (sensible defaults built in) ---

# Port the server listens on. 8484 avoids Immich (2283) and other common ports.
#PLANNER_PORT=8484

# Models. Defaults are the cheap ones; a typical voice note costs well under a cent.
#TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
#TASKS_MODEL=gpt-4.1-mini

# Which Google Tasks list to add to. @default = your main list.
#GOOGLE_TASKLIST=@default

# Optional: Google Places API key. Without it, locations are geocoded via
# OpenStreetMap only (streets/areas/cities). With it, business and venue
# names ("Παπαδάκης οδοντίατρος, Λάρισα") resolve too, as a fallback.
#GOOGLE_PLACES_API_KEY=

# Optional: names the transcriber often mis-hears (people, shops, places you
# say a lot). Comma-separated; added to the recognition hints on every note.
#PLANNER_VOCAB=Παπαδάκης, Χαλάνδρι

# Calendar events use the Pi's own timezone (/etc/timezone); override here.
#CALENDAR_TIMEZONE=Europe/Berlin

# Where results are stored / where the Google token lives.
#DATA_DIR=/home/pi/voice-planner/data
#GOOGLE_TOKEN_FILE=/home/pi/voice-planner/google/token.json
